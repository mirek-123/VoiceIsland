<?xml version="1.0" encoding="utf-8"?>
<!-- New theme: grows in from 82 % with a small overshoot. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/overshoot_interpolator">
    <scale
        android:duration="560"
        android:fromXScale="0.82"
        android:fromYScale="0.82"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
    <alpha
        android:duration="320"
        android:fromAlpha="0"
        android:interpolator="@android:anim/decelerate_interpolator"
        android:toAlpha="1" />
</set>
