<?xml version="1.0" encoding="utf-8"?>
<!--
  Two slots (current theme / previous theme) per part: the backdrop and labels cross-fade, the
  island pops in. Inside each island slot six idle frames cross-fade in a loop.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Backdrop lit by the theme (drawn in IslandWidgets.cardGlowArt). -->
    <ViewFlipper
        android:id="@+id/widget_glow_slots"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@anim/widget_fade_in"
        android:outAnimation="@anim/widget_fade_out">

        <ImageView android:id="@+id/widget_glow_0" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
        <ImageView android:id="@+id/widget_glow_1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ViewFlipper
            android:id="@+id/widget_preview_slots"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:inAnimation="@anim/widget_theme_in"
            android:outAnimation="@anim/widget_theme_out">

            <ViewFlipper
                android:id="@+id/widget_island_idle0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="800"
                android:inAnimation="@anim/widget_idle_in"
                android:outAnimation="@anim/widget_idle_out">

                <ImageView android:id="@+id/widget_island_0_0" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/ic_launcher" />
                <ImageView android:id="@+id/widget_island_0_1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_0_2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_0_3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_0_4" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_0_5" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            </ViewFlipper>

            <ViewFlipper
                android:id="@+id/widget_island_idle1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="800"
                android:inAnimation="@anim/widget_idle_in"
                android:outAnimation="@anim/widget_idle_out">

                <ImageView android:id="@+id/widget_island_1_0" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_1_1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_1_2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_1_3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_1_4" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/widget_island_1_5" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            </ViewFlipper>
        </ViewFlipper>

        <ViewFlipper
            android:id="@+id/widget_swatch_slots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:inAnimation="@anim/widget_fade_in"
            android:outAnimation="@anim/widget_fade_out">

            <ImageView android:id="@+id/widget_swatch_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_swatch_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
        </ViewFlipper>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Previous theme"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_back"
                android:tint="#FFFFFF" />

            <ViewFlipper
                android:id="@+id/widget_label_slots"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inAnimation="@anim/widget_fade_in"
                android:outAnimation="@anim/widget_fade_out">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/widget_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="15sp" />
                    <TextView android:id="@+id/widget_count_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/widget_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="15sp" />
                    <TextView android:id="@+id/widget_count_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#99FFFFFF" android:textSize="11sp" />
                </LinearLayout>
            </ViewFlipper>

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Next theme"
                android:padding="10dp"
                android:src="@drawable/ic_chevron"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Light edge on top of everything. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_rim" />
</FrameLayout>
