<?xml version="1.0" encoding="utf-8"?>
<!--
  No background: the orb floats on the wallpaper. Two slots (current theme / previous theme) swap
  with a pop when the theme changes; inside each, six idle frames cross-fade in a loop.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="Talk to your assistant">

    <ViewFlipper
        android:id="@+id/widget_orb_slots"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@anim/widget_theme_in"
        android:outAnimation="@anim/widget_theme_out">

        <ViewFlipper
            android:id="@+id/widget_orb_idle0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="800"
            android:inAnimation="@anim/widget_idle_in"
            android:outAnimation="@anim/widget_idle_out">

            <ImageView android:id="@+id/widget_orb_0_0" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/ic_launcher" />
            <ImageView android:id="@+id/widget_orb_0_1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_0_2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_0_3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_0_4" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_0_5" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
        </ViewFlipper>

        <ViewFlipper
            android:id="@+id/widget_orb_idle1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="800"
            android:inAnimation="@anim/widget_idle_in"
            android:outAnimation="@anim/widget_idle_out">

            <ImageView android:id="@+id/widget_orb_1_0" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_1_1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_1_2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_1_3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_1_4" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/widget_orb_1_5" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
        </ViewFlipper>
    </ViewFlipper>
</FrameLayout>
